function toggleFilterMenu(e) {
  e.stopPropagation();
  $("filterMenu").classList.toggle("show");
}

function toggleFilterStatus(cb) {
  if (cb.checked) filterStatuses.push(cb.value);
  else filterStatuses = filterStatuses.filter(s => s !== cb.value);
