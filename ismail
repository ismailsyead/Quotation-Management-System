function statusLabel(s){
  if (lang !== "ar") return s;
  return ({ Draft:"مسودة", Sent:"مرسل", Approved:"معتمد", Rejected:"مرفوض" }[s] || s);
}

function activeQuotes(){
  return quotes.filter(q =>
    q.companyId === activeCompanyId ||
    (!q.companyId && activeCompanyId === companies[0].id)
  );
}

function row(q, idx, actions){
  const a = amounts(q);
  let actionCell = "";
  if (actions) {
    const previewBtn = `<button class="btn-light btn-xs" onclick="previewQuote(${q.id})">${t("preview")}</button>`;
    const printBtn   = `<button class="btn-light btn-xs" onclick="printQuote(${q.id})">${t("print")}</button>`;
    const pdfBtn     = `<button class="btn-light btn-xs" onclick="pdfQuote(${q.id})">PDF</button>`;
    const excelBtn   = `<button class="btn-light btn-xs" onclick="excelQuote(${q.id})">Excel</button>`;
    const editBtn    = can("edit")   ? `<button class="btn-light btn-xs" onclick="editQuote(${q.id})">${t("edit")}</button>` : "";
    const delBtn     = can("delete") ? `<button class="btn-danger btn-xs" onclick="deleteQuote(${q.id})">${t("delete")}</button>` : "";
    actionCell = `<td style="white-space:nowrap; text-align:center;">${previewBtn}${printBtn}${pdfBtn}${excelBtn}${editBtn}${delBtn}</td>`;
  }
  return `<tr>
    <td>${idx + 1}</td>
    <td><strong>${esc(q.number)}</strong></td>
    <td>${esc(q.date)}</td>
    <td>${esc(q.customer || "N/A")}</td>
    <td>${fmt(a.total)}</td>
    <td><span class="tag">${esc(statusLabel(q.status))}</span></td>
    ${actionCell}
  </tr>`;
}

function renderCharts(list) {
  const isDark = document.body.classList.contains("dark-mode");
  const textColor = isDark ? "#cbd5e1" : "#64748b";
  const gridColor = isDark ? "#334155" : "#e2e8f0";

  const statuses = ["Draft", "Sent", "Approved", "Rejected"];
  const statusCounts = statuses.map(s => list.filter(q => q.status === s).length);
  const statusColors = ["#94a3b8", "#3b82f6", "#10b981", "#ef4444"];

  if (statusChartInstance) statusChartInstance.destroy();
  const statusCtx = $("statusChart").getContext("2d");
  statusChartInstance = new Chart(statusCtx, {
    type: 'doughnut',
    data: {
      labels: statuses.map(s => statusLabel(s)),
      datasets: [{ data: statusCounts, backgroundColor: statusColors, borderWidth: 0, hoverOffset: 4 }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { position: 'bottom', labels: { color: textColor, font: { family: 'Arial', weight: 'bold' } } } }
    }
  });

  const monthData = {};
  list.forEach(q => {
    if (!q.date) return;
    const m = q.date.substring(0, 7);
    monthData[m] = (monthData[m] || 0) + amounts(q).total;
  });
  const sortedMonths = Object.keys(monthData).sort();
  const monthLabels = sortedMonths.map(m => {
    const d = new Date(m + "-01");
    return d.toLocaleString('default', { month: 'short', year: 'numeric' });
  });
  const monthTotals = sortedMonths.map(m => monthData[m]);

  if (revenueChartInstance) revenueChartInstance.destroy();
  const revenueCtx = $("revenueChart").getContext("2d");
  revenueChartInstance = new Chart(revenueCtx, {
    type: 'bar',
    data: {
      labels: monthLabels,
      datasets: [{ label: 'Revenue (SAR)', data: monthTotals, backgroundColor: '#c99b45', borderRadius: 6, barThickness: 30 }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      scales: {
        x: { ticks: { color: textColor, font: { weight: 'bold' } }, grid: { display: false } },
        y: { ticks: { color: textColor, font: { weight: 'bold' } }, grid: { color: gridColor } }
      },
      plugins: { legend: { display: false } }
    }
  });
}

function scheduleCharts(list){
  clearTimeout(_chartTimer);
  _chartTimer = setTimeout(() => renderCharts(list), 150);
}

function renderAll(){
  const list = activeQuotes();

  const recent = [...list].sort((a, b) => b.id - a.id).slice(0, 5);
  $("recentRows").innerHTML = recent.length
    ? recent.map((q, i) => row(q, i, false)).join("")
    : `<tr><td colspan="6" class="empty">${t("noRecords")}</td></tr>`;

  // APPLY FILTERS
  const s = ($("search") && $("search").value || "").toLowerCase();
  const cFilter = $("filterCompany") ? $("filterCompany").value : "";
  
  let filtered = list.filter(q => (String(q.number) + " " + String(q.customer)).toLowerCase().includes(s));
  
  if (cFilter) filtered = filtered.filter(q => q.customer === cFilter);
  
  if (filterStatuses.length > 0) {
    filtered = filtered.filter(q => filterStatuses.includes(q.status));
  }

  $("allRows").innerHTML = filtered.length
    ? filtered.map((q, i) => row(q, i, true)).join("")
    : `<tr><td colspan="7" class="empty">${t("noRecords")}</td></tr>`;

  // Stats now reflect the filtered list
  const total = filtered.reduce((sum, q) => sum + amounts(q).total, 0);
  $("statCount").textContent    = filtered.length;
  $("statValue").textContent    = fmt(total);
  $("statDraft").textContent    = filtered.filter(q => q.status === "Draft" || q.status === "Sent").length;
  $("statApproved").textContent = filtered.filter(q => q.status === "Approved").length;

  scheduleCharts(filtered);
}

