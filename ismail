function handleLogoUpload(e){
  const file = e.target.files[0]; if (!file) return;
  if (file.size > 1024 * 1024) { alert(t("imageTooLarge").replace("{size}","1MB")); e.target.value = ""; return; }
  const reader = new FileReader();
  reader.onload = ev => {
    $("compLogo").value = ev.target.result;
    $("logoPreview").src = ev.target.result;
    $("logoPreview").style.display = "block";
    $("logoPlaceholder").style.display = "none";
  };
  reader.readAsDataURL(file);
}

function handleA4Upload(e){
  const file = e.target.files[0]; if (!file) return;
  if (file.size > 3 * 1024 * 1024) { alert(t("imageTooLarge").replace("{size}","3MB")); e.target.value = ""; return; }
  const reader = new FileReader();
  reader.onload = ev => {
    const img = new Image();
    img.onload = () => {
      const MAX_W = 1200;
      const scale = Math.min(MAX_W / img.width, 1);
      const canvas = document.createElement("canvas");
      canvas.width  = Math.round(img.width  * scale);
      canvas.height = Math.round(img.height * scale);
      canvas.getContext("2d").drawImage(img, 0, 0, canvas.width, canvas.height);
      const base64 = canvas.toDataURL("image/jpeg", 0.8);
      $("compA4").value = base64;
      $("a4Preview").src = base64;
      $("a4Preview").style.display = "block";
      $("a4Placeholder").style.display = "none";
      updateVisualEditorBackground(base64);
      extractColorsFromImage(base64);
    };
    img.src = ev.target.result;
  };
  reader.readAsDataURL(file);
}

