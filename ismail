/* ============================================================
   VISUAL LAYOUT EDITOR
   ============================================================ */
function initDragEditor() {
  if (_dragReady) return;
  _dragReady = true;

  const container = $("pdfVisualEditor");
  if(!container) return;

  const dragItems = container.querySelectorAll(".drag-item");

  dragItems.forEach(el => {
    el.addEventListener("mousedown", (e) => {
      document.querySelectorAll(".drag-item").forEach(d => d.classList.remove("selected"));
      el.classList.add("selected");
      selectedBlockKey = el.dataset.key;
      showBlockProperties(selectedBlockKey);

      const rect = el.getBoundingClientRect();
      if (e.clientX > rect.right - 20 && e.clientY > rect.bottom - 20) return;

      isDragging = true;
      currentDrag = el;
      offsetX = e.clientX - rect.left;
      offsetY = e.clientY - rect.top;
      e.preventDefault();
    });
  });

  document.addEventListener("mousemove", (e) => {
    if (!isDragging || !currentDrag) return;
    const containerRect = container.getBoundingClientRect();

    let xPx = e.clientX - containerRect.left - offsetX;
    let yPx = e.clientY - containerRect.top - offsetY;

    let xPercent = (xPx / container.clientWidth) * 100;
    let yPercent = (yPx / container.clientHeight) * 100;

    xPercent = Math.max(0, Math.min(xPercent, 100 - (currentDrag.offsetWidth / container.clientWidth * 100)));
    yPercent = Math.max(0, Math.min(yPercent, 100 - (currentDrag.offsetHeight / container.clientHeight * 100)));

    currentDrag.style.left = xPercent + "%";
    currentDrag.style.top = yPercent + "%";
  });

  document.addEventListener("mouseup", () => {
    if (isDragging && currentDrag) updateLayoutFromVisual();
    isDragging = false;
    currentDrag = null;
  });

  let resizeTimer;
  container.addEventListener("mouseup", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(updateLayoutFromVisual, 100);
  });

  $("propFont").addEventListener("change", updateBlockStyle);
  $("propSize").addEventListener("input", updateBlockStyle);
  $("propHeight").addEventListener("input", updateBlockStyle);
  $("propColor").addEventListener("input", updateBlockStyle);
  $("propBold").addEventListener("change", updateBlockStyle);
}

function showBlockProperties(key) {
  if (!key) {
    $("noBlockSelected").style.display = "block";
    $("propControls").style.display = "none";
    return;
  }
  $("noBlockSelected").style.display = "none";
  $("propControls").style.display = "block";

  const layout = layoutOfEditTarget();
  const block = layout[key] || defaultLayout[key];

  $("propFont").value   = block.fontFamily || "Arial, sans-serif";
  $("propSize").value   = block.fontSize || 14;
  $("propHeight").value = block.h || 10;
  $("propColor").value  = block.color || "#000000";
  $("propBold").checked = block.bold !== false;
}

function updateBlockStyle() {
  if (!selectedBlockKey) return;
  const el = document.querySelector(`.drag-item[data-key="${selectedBlockKey}"]`);
  if (!el) return;

  el.style.fontFamily = $("propFont").value;
  el.style.fontSize   = $("propSize").value + "px";
  el.style.height     = $("propHeight").value + "%";
  el.style.color      = $("propColor").value;
  el.style.fontWeight = $("propBold").checked ? "800" : "400";

  updateLayoutFromVisual();
}

function hideSelectedBlock() {
  if (!selectedBlockKey) return;
  const key = selectedBlockKey;
  layoutOfEditTarget()[key].hidden = true;

  const el = document.querySelector(`.drag-item[data-key="${key}"]`);
  if (el) el.style.display = "none";

  document.querySelectorAll(".drag-item").forEach(d => d.classList.remove("selected"));
  selectedBlockKey = null;
  showBlockProperties(null);
  renderHiddenBlocksList();
  updateLayoutFromVisual();
}

function showBlock(key) {
  layoutOfEditTarget()[key].hidden = false;
  const el = document.querySelector(`.drag-item[data-key="${key}"]`);
  if (el) el.style.display = "block";
  renderHiddenBlocksList();
  updateLayoutFromVisual();
}

function renderHiddenBlocksList() {
  const layout = layoutOfEditTarget();
  const container = $("hiddenButtons");
  if (!container) return;
  container.innerHTML = "";

  Object.keys(layout).forEach(key => {
    if (layout[key].hidden) {
      const btn = document.createElement("button");
      btn.className = "hidden-block-btn";
      btn.innerHTML = `↩ ${key.charAt(0).toUpperCase() + key.slice(1)}`;
      btn.onclick = () => showBlock(key);
      container.appendChild(btn);
    }
  });

  if (container.innerHTML === "") {
    container.innerHTML = '<div class="muted" style="font-size:11px; padding:5px;">No hidden blocks</div>';
  }
}

function updateLayoutFromVisual() {
  const container = $("pdfVisualEditor");
  if(!container) return;

  const cw = container.clientWidth;
  const ch = container.clientHeight;
  const layout = layoutOfEditTarget();

  ["offer", "customer", "intro", "table", "notes", "closing"].forEach(key => {
    const el = document.querySelector(`.drag-item[data-key="${key}"]`);
    if (!el) return;

    if (el.style.display !== "none") {
      layout[key].x = Math.round((el.offsetLeft / cw) * 100);
      layout[key].y = Math.round((el.offsetTop / ch) * 100);
      layout[key].w = Math.round((el.offsetWidth / cw) * 100);
      layout[key].h = Math.round((el.offsetHeight / ch) * 100);

      $(`l_${key}X`).value = layout[key].x;
      $(`l_${key}Y`).value = layout[key].y;
      $(`l_${key}W`).value = layout[key].w;
      $(`l_${key}H`).value = layout[key].h;
    }

    if (key === selectedBlockKey) {
      layout[key].fontFamily = $("propFont").value;
      layout[key].fontSize   = Number($("propSize").value);
      layout[key].color      = $("propColor").value;
      layout[key].bold       = $("propBold").checked;
    }
  });
}

function syncVisualEditorFromLayout(layout) {
  const container = $("pdfVisualEditor");
  if(!container) return;

  layout = layout || layoutOfEditTarget();

  ["offer", "customer", "intro", "table", "notes", "closing"].forEach(key => {
    const el = document.querySelector(`.drag-item[data-key="${key}"]`);
    if (!el) return;

    const block = layout[key] || defaultLayout[key];

    if (block.hidden) {
      el.style.display = "none";
    } else {
      el.style.display = "block";
      el.style.left = block.x + "%";
      el.style.top = block.y + "%";
      el.style.width = block.w + "%";
      el.style.height = block.h + "%";
      el.style.fontFamily = block.fontFamily || 'Arial, sans-serif';
      el.style.fontSize = (block.fontSize || 14) + "px";
      el.style.color = block.color || "#1e293b";
      el.style.fontWeight = (block.bold !== false) ? "800" : "400";
    }

    $(`l_${key}X`).value = block.x;
    $(`l_${key}Y`).value = block.y;
    $(`l_${key}W`).value = block.w;
    $(`l_${key}H`).value = block.h;
  });

  renderHiddenBlocksList();
  showBlockProperties(null);
}

function updateVisualEditorBackground(b64) {
  const val = b64 !== undefined ? b64 : $("compA4").value;
  const editor = $("pdfVisualEditor");
  if (!editor) return;
  if (val) {
    editor.style.backgroundImage = `url('${val}')`;
    editor.style.backgroundSize = "100% 100%";
    editor.style.backgroundPosition = "center";
    editor.style.backgroundRepeat = "no-repeat";
  } else {
    const isDark = document.body.classList.contains("dark-mode");
    const gridColor = isDark ? "rgba(255,255,255,0.05)" : "rgba(0,0,0,0.03)";
    editor.style.backgroundImage = `linear-gradient(to right, ${gridColor} 1px, transparent 1px), linear-gradient(to bottom, ${gridColor} 1px, transparent 1px)`;
    editor.style.backgroundSize = "20px 20px";
    editor.style.backgroundPosition = "top left";
