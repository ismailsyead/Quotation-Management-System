/* ============================================================
   PERMISSIONS & ROLES
   ============================================================ */
const PERM_DEFAULTS = { create:true, edit:true, delete:false, master:false, company:false, users:false, switch:true };

function getPerms(){
  const raw = localStorage.getItem(LS.perms);
  if (!raw) return {};
  let parsed = JSON.parse(raw);
  if (parsed.create !== undefined) {
    const migrated = { "User": parsed };
    localStorage.setItem(LS.perms, JSON.stringify(migrated));
    return migrated;
  }
  return parsed;
}

function can(perm){
  if (!currentUser) return false;
  if (currentUser.role === "Admin") return true;
  if (!perm) return true;

  const allPerms = getPerms();
  const rolePerms = allPerms[currentUser.role] || {};
  return rolePerms[perm] !== undefined ? !!rolePerms[perm] : PERM_DEFAULTS[perm] !== false;
}

function applyNavPermissions(){
  document.querySelectorAll(".nav button[data-perm]").forEach(btn => {
    const perm = btn.dataset.perm;
    btn.style.display = (perm && !can(perm)) ? "none" : "";
  });
}

function renderPermissionsTable() {
  const thead = $("permissionsTableHead");
  const tbody = $("permissionsTableBody");
  if (!thead || !tbody) return;

  const allPerms = getPerms();

  thead.innerHTML = `<tr><th style="text-align:left;">${t('records')}</th>${roles.map(r => `
    <th>
      <div style="display:flex; align-items:center; gap:8px;">
        <span>${esc(r)}</span>
        ${r !== 'Admin' ? `
          <div style="display:flex; gap:4px;">
            <button class="btn-light btn-xs" style="padding:4px 8px; font-size:12px;" data-role="${esc(r)}" onclick="editRole(this.dataset.role)" title="Edit Role">✏️</button>
            <button class="btn-danger btn-xs" style="padding:4px 8px; font-size:12px;" data-role="${esc(r)}" onclick="deleteRole(this.dataset.role)" title="Delete Role">🗑️</button>
          </div>` : ''}
      </div>
    </th>`).join('')}</tr>`;

  tbody.innerHTML = FEATURES.map(f => {
    return `<tr><td>${esc(f.name)}</td>${roles.map((r, idx) => {
      if (r === "Admin") return `<td><input type="checkbox" checked disabled></td>`;
      const isChecked = (allPerms[r] && allPerms[r][f.key] !== undefined) ? allPerms[r][f.key] : (PERM_DEFAULTS[f.key] !== false);
      return `<td><input type="checkbox" id="perm_${idx}_${f.key}" ${isChecked ? 'checked' : ''}></td>`;
    }).join('')}</tr>`;
  }).join('');
}

function addRole() {
  const name = $("newRoleName").value.trim();
  if (!name) return;
  if (roles.includes(name)) return alert(t("noRoleExists"));
  roles.push(name);
  persistRoles();
  $("newRoleName").value = "";
  renderPermissionsTable();
  populateRolesDropdown();
  toast(t("roleAdded"));
}

function editRole(oldName) {
  const newName = prompt("Enter new name for role:", oldName);
  if (!newName || newName === oldName) return;
  if (roles.includes(newName)) return alert(t("noRoleExists"));

  const idx = roles.indexOf(oldName);
  roles[idx] = newName;

  users.forEach(u => { if (u.role === oldName) u.role = newName; });

  const perms = getPerms();
  if (perms[oldName]) {
    perms[newName] = perms[oldName];
    delete perms[oldName];
    localStorage.setItem(LS.perms, JSON.stringify(perms));
  }

  persistRoles();
  persistUsers();
  renderPermissionsTable();
  populateRolesDropdown();
  renderUsers();
  toast(t("roleUpdated"));
}

function deleteRole(roleName) {
  if (roleName === "Admin") return alert(t("cannotDeleteAdmin"));
  if (!confirm(t("deleteRoleConfirm").replace("{role}", roleName))) return;

  roles = roles.filter(r => r !== roleName);
  users.forEach(u => { if (u.role === roleName) u.role = "User"; });

  const perms = getPerms();
  delete perms[roleName];
  localStorage.setItem(LS.perms, JSON.stringify(perms));

  persistRoles();
  persistUsers();
  renderPermissionsTable();
  populateRolesDropdown();
  renderUsers();
  toast(t("roleDeleted"));
}

function savePermissions(){
  const allPerms = {};
  roles.forEach((r, idx) => {
    if (r === "Admin") return;
    allPerms[r] = {};
    FEATURES.forEach(f => {
      const cb = $(`perm_${idx}_${f.key}`);
      if (cb) allPerms[r][f.key] = cb.checked;
    });
  });
  localStorage.setItem(LS.perms, JSON.stringify(allPerms));
  applyNavPermissions();
  populateCompanyDropdown();
  toast(t("permissionsSaved"));
}

function populateRolesDropdown() {
  const sel = $("newUserRole");
  if (!sel) return;
  const current = sel.value;
  sel.innerHTML = roles.map(r => `<option value="${esc(r)}">${esc(r)}</option>`).join("");
  if (roles.includes(current)) sel.value = current;
}

