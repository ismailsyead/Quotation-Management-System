function waitForImages(container, callback){
  const imgs = Array.from(container.querySelectorAll("img"));
  if (!imgs.length) return callback();
  let remaining = imgs.length, called = false;
  const done = () => {
    if (called) return;
    if (--remaining <= 0) { called = true; callback(); }
  };
  imgs.forEach(img => {
    if (img.complete && img.naturalWidth !== 0) done();
    else { img.addEventListener("load", done, { once:true }); img.addEventListener("error", done, { once:true }); }
  });
  setTimeout(() => { if (!called) { called = true; callback(); } }, 3000);
}

function generateExcelHTML(q){
  const comp = companies.find(c => c.id === q.companyId) || getActiveCompany();
  const themeColor = (comp.theme && comp.theme.primary) || "#142b49";
  const a = amounts(q);
  const r = v => String(v ?? "");

  let itemsRows = "";
  if (q.items && q.items.length) {
    q.items.forEach(it => {
      const sub = (it.days||0) * (it.vehicles||0) * (it.costVehicle||0);
      itemsRows += `<tr>
        <td>${r(it.vehicle)}</td>
        <td>${r(it.transportDetails)}</td>
        <td>${r(it.startDate)}</td>
        <td>${r(it.endDate)}</td>
        <td>${it.days}</td>
        <td>${it.vehicles}</td>
        <td>${fmt(it.costVehicle)}</td>
        <td>${fmt(sub)}</td>
      </tr>`;
    });
  } else if (q.vehicle) {
    itemsRows = `<tr>
        <td>${r(q.vehicle)}</td>
        <td>${r(q.transportDetails)}</td>
        <td>${r(q.startDate)}</td>
        <td>${r(q.endDate)}</td>
        <td>${q.days}</td>
        <td>${q.vehicles}</td>
        <td>${fmt(q.costVehicle)}</td>
        <td>${fmt(a.sub)}</td>
    </tr>`;
  }

  return `<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
  <head><meta charset="UTF-8"></head><body>
  <table border="1">
    <tr><th colspan="8" style="background:${themeColor};color:#fff;">${r(comp.name)} — QUOTATION (${r(q.number)})</th></tr>
    <tr><td>Date</td><td>${r(q.date)}</td><td>Customer</td><td colspan="5">${r(q.customer)}</td></tr>
    <tr style="font-weight:bold; background:#f0f0f0;">
      <th>Vehicle</th><th>Description</th><th>Start</th><th>End</th><th>Days</th><th>Qty</th><th>Cost/Vehicle</th><th>Subtotal (SAR)</th>
    </tr>
    ${itemsRows}
    <tr><td colspan="7" align="right">SUB TOTAL (SAR)</td><td>${fmt(a.sub)}</td></tr>
    <tr><td colspan="7" align="right">VAT (${r(q.vat)}%) (SAR)</td><td>${fmt(a.vat)}</td></tr>
    <tr style="font-weight:bold;background:#f4b900;"><td colspan="7" align="right">GRAND TOTAL (SAR)</td><td>${fmt(a.total)}</td></tr>
    <tr><td colspan="7" align="right">GRAND TOTAL (USD)</td><td>$${fmt(a.usdTotal)}</td></tr>
    <tr><td colspan="2">Notes</td><td colspan="6">${r(q.notes)}</td></tr>
    <tr><td colspan="2">Payment</td><td colspan="6">${r(q.payment)}</td></tr>
  </table></body></html>`;
}

function downloadExcelHTML(html, filename){
  const blob = new Blob([html], { type:"application/vnd.ms-excel" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = filename;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

function exportPDF(q, after){
  $("printArea").innerHTML = quoteHTML(q);
  showPage("printArea", null);
  document.body.classList.add("exporting");

  waitForImages($("printArea"), () => {
    const element = $("printArea").querySelector('.quote-paper');
    
    // Force strict A4 dimensions and overflow hidden
    element.style.width = '210mm';
    element.style.height = '297mm';
    element.style.minHeight = '297mm';
    element.style.overflow = 'hidden';
    element.style.position = 'relative';

    html2canvas(element, {
      scale: 2, // High resolution
      useCORS: true,
      allowTaint: true,
      backgroundColor: "#ffffff",
      windowWidth: 794, // 210mm at 96 DPI
      scrollX: 0,
      scrollY: 0
    }).then(canvas => {
      const imgData = canvas.toDataURL('image/jpeg', 0.98);
      const { jsPDF } = window.jspdf;
      const pdf = new jsPDF('p', 'mm', 'a4');
      
      const pdfWidth = pdf.internal.pageSize.getWidth();
      const pdfHeight = pdf.internal.pageSize.getHeight();
      
      pdf.addImage(imgData, 'JPEG', 0, 0, pdfWidth, pdfHeight);
      pdf.save(`Quotation_${q.number || "New"}.pdf`);
      
      document.body.classList.remove("exporting");
      if (after) after();
    }).catch(err => {
      console.error(err);
      document.body.classList.remove("exporting");
      if (after) after();
    });
  });
}

function exportPrint(q, backTo){
  $("printArea").innerHTML = quoteHTML(q);
  showPage("printArea", null);
  waitForImages($("printArea"), () => {
    adjustPaperHeight();
    setTimeout(() => {
      window.print();
      setTimeout(() => showPage(backTo, document.querySelector(`[data-page="${backTo}"]`)), 400);
    }, 250);
  });
}

function doExport(type){
  const q = values();
  if (type === "print") exportPrint(q, "quotes");
  else if (type === "pdf") exportPDF(q, () => showPage("new", document.querySelector('[data-page="quotes"]')));
  else if (type === "excel") downloadExcelHTML(generateExcelHTML(q), `Quotation_${q.number || "New"}.xls`);
}

