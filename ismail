      <input type="number" class="v-qty" value="1" min="1" oninput="calcRow(this)">
    </div>
    <div class="field">
      <label data-i="cost">Cost</label>
      <input type="number" class="v-cost" value="0" min="0" step=".01" oninput="calcRow(this)">
    </div>
    <div class="field v-sub">
      <label data-i="subtotal">Subtotal</label>
      <input class="v-subtotal" readonly value="0.00">
    </div>
    <button type="button" class="btn-remove" onclick="this.parentElement.remove(); calc();">✕</button>
  `;

  container.appendChild(row);

  if (data) {
    if (comp.vehicles.some(x => x.name === data.vehicle)) {
      row.querySelector(".v-type").value = data.vehicle;
    } else if (data.vehicle) {
      row.querySelector(".v-type").value = "Other";
      row.querySelector(".v-custom").value = data.vehicle;
      row.querySelector(".v-custom").style.display = "block";
    }
    row.querySelector(".v-desc-input").value = data.transportDetails || "";
    row.querySelector(".v-start").value = data.startDate || "";
    row.querySelector(".v-end").value = data.endDate || "";
    row.querySelector(".v-days").value = data.days || 1;
    row.querySelector(".v-qty").value = data.vehicles || 1;
    row.querySelector(".v-cost").value = data.costVehicle || 0;
  }

  calcRow(row);
}

function toggleCustomVehicle(select) {
  const row = select.closest(".vehicle-row");
  const customInput = row.querySelector(".v-custom");
  if (select.value === "Other") {
    customInput.style.display = "block";
    customInput.focus();
  } else {
    customInput.style.display = "none";
    customInput.value = "";
  }
  calcRow(select);
}

function calcRow(el) {
  const row = el.closest(".vehicle-row");
  if (!row) return;

  const start = row.querySelector(".v-start").value;
  const end = row.querySelector(".v-end").value;
  const daysInput = row.querySelector(".v-days");

  if (start && end && el !== daysInput) {
    const s = new Date(start);
    const e = new Date(end);
    if (e >= s) daysInput.value = Math.round((e - s) / 86400000) + 1;
  }

  const days = Number(daysInput.value) || 0;
  const qty = Number(row.querySelector(".v-qty").value) || 0;
  const cost = Number(row.querySelector(".v-cost").value) || 0;

  const sub = days * qty * cost;
  row.querySelector(".v-subtotal").value = fmt(sub);

  calc();
}

function getCompanyPrefix(compName) {
  if (!compName) return "QT";
  let cleanName = compName.toUpperCase().replace(/[^A-Z0-9\s]/g, '');
  cleanName = cleanName.replace(/\b(CO|COMPANY|CORP|CORPORATION|LLC|LTD|LIMITED|INC|INCORPORATED)\b/g, '').trim();

  const words = cleanName.split(/\s+/).filter(w => w.length > 0);
  if (words.length === 0) return "QT";
  if (words.length === 1) return words[0].substring(0, 2);
  return words[0].charAt(0) + words[1].charAt(0);
}

function nextNumber(){
  const comp = getActiveCompany();
  if (!comp) return "QT-001";
  const compId = comp.id;
  const prefix = getCompanyPrefix(comp.name);

  const max = quotes
    .filter(q => (q.companyId ?? companies[0].id) === compId)
    .reduce((m, q) => {
      const match = String(q.number || "").match(/(\d+)\s*$/);
      return Math.max(m, match ? Number(match[1]) : 0);
    }, 0);
    
  return prefix + "-" + String(max + 1).padStart(3, "0");
}

