   ============================================================ */
function doLogin(){
  const u = $("loginUser").value.trim();
  const p = $("loginPass").value;
  const user = users.find(x => String(x.username).toLowerCase() === u.toLowerCase() && x.password === p);
  if (!user) { alert(t("invalidCredentials")); return; }
  currentUser = user;
  $("loginScreen").style.display = "none";
  $("app").style.display = "flex";
  loadData();
  updateTopbarProfile();
}

function doLogout(){
  currentUser = null;
  $("app").style.display = "none";
  $("loginScreen").style.display = "flex";
  $("loginPass").value = "";
  $("topUserAvatar").style.display = "none";
  $("topUserFallback").style.display = "flex";
  $("topUserName").textContent = "User";
}

function updateTopbarProfile(){
  if(!currentUser) return;

  const avatarImg = $("topUserAvatar");
  const fallback = $("topUserFallback");
  const nameSpan = $("topUserName");

  nameSpan.textContent = currentUser.name;

  if(currentUser.picture && currentUser.picture.startsWith("data:image")) {
    avatarImg.src = currentUser.picture;
    avatarImg.style.display = "block";
    fallback.style.display = "none";
  } else {
    avatarImg.style.display = "none";
    fallback.style.display = "flex";
    fallback.textContent = currentUser.name.charAt(0).toUpperCase();
  }
}

function loadProfileData() {
  if (!currentUser) return;
  $("profName").value = currentUser.name || "";
  $("profEmail").value = currentUser.email || "";
  $("profMobile").value = currentUser.mobile || "";
  $("profNewPass").value = "";
  
  const preview = $("profPicPreview");
  if (currentUser.picture && currentUser.picture.startsWith("data:image")) {
    preview.src = currentUser.picture;
    preview.style.display = "block";
  } else {
    preview.removeAttribute("src");
    preview.style.display = "none";
  }

  // ADMIN CONTROLS
  if (currentUser.role === "Admin") {
    $("adminOnlyPanels").style.display = "block";
    loadLoginSettingsUI();
    loadDashboardSettingsUI();
  } else {
    $("adminOnlyPanels").style.display = "none";
  }
}

function handleProfPicUpload(e) {
  const file = e.target.files[0]; if (!file) return;
  if (file.size > 500 * 1024) { alert(t("imageTooLarge").replace("{size}","500KB")); e.target.value = ""; return; }
  const reader = new FileReader();
  reader.onload = ev => {
    $("profPicPreview").src = ev.target.result;
    $("profPicPreview").style.display = "block";
  };
  reader.readAsDataURL(file);
}

function saveMyProfile() {
