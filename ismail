/* ============================================================
   CALCULATIONS (GLOBAL)
   ============================================================ */
function amounts(q){
  let sub = 0;
  if (Array.isArray(q.items) && q.items.length) {
    q.items.forEach(it => {
      sub += (Number(it.vehicles)||0) * (Number(it.days)||0) * (Number(it.costVehicle)||0);
    });
  } else if (q.vehicle) {
    sub = (Number(q.vehicles)||0) * (Number(q.days)||0) * (Number(q.costVehicle)||0);
  }
  const vat = sub * (Number(q.vat) || 0) / 100;
  const total = sub + vat;
  return {
    sub, vat, total,
    usdSub: sub / EXCHANGE_RATE,
    usdVat: vat / EXCHANGE_RATE,
    usdTotal: total / EXCHANGE_RATE
  };
}

function calc(){
  let sub = 0;
  document.querySelectorAll(".vehicle-row").forEach(row => {
    const days = Number(row.querySelector(".v-days").value) || 0;
    const qty = Number(row.querySelector(".v-qty").value) || 0;
    const cost = Number(row.querySelector(".v-cost").value) || 0;
    sub += days * qty * cost;
  });

  const vatRate = Number($("vat").value) || 0;
  const vat = sub * vatRate / 100;
  const total = sub + vat;

  $("vSubtotal").textContent = "SAR " + fmt(sub);
  $("vUsdSub").textContent   = "$" + fmt(sub / EXCHANGE_RATE);

  $("vVat").textContent      = "SAR " + fmt(vat);
  $("vUsdVat").textContent   = "$" + fmt(vat / EXCHANGE_RATE);

  $("vGrand").textContent    = "SAR " + fmt(total);
  $("vGrandUsd").textContent = "$" + fmt(total / EXCHANGE_RATE) + " USD";

  $("vUsdGrand").textContent = "$" + fmt(total / EXCHANGE_RATE);
}

$("vat").addEventListener("input", calc);

/* ============================================================
   QUOTE CRUD
   ============================================================ */
function values(){
  const items = [];
  document.querySelectorAll(".vehicle-row").forEach(row => {
    let vType = row.querySelector(".v-type").value;
    if (vType === "Other") vType = row.querySelector(".v-custom").value.trim();

    const cost = Number(row.querySelector(".v-cost").value) || 0;
    const qty = Number(row.querySelector(".v-qty").value) || 0;

    if (vType || cost > 0 || qty > 0) {
      items.push({
        vehicle: vType || "Vehicle",
        transportDetails: row.querySelector(".v-desc-input").value,
        startDate: row.querySelector(".v-start").value,
        endDate: row.querySelector(".v-end").value,
        days: Number(row.querySelector(".v-days").value) || 0,
        vehicles: qty,
        costVehicle: cost
      });
    }
  });

  const existing = quotes.find(x => x.id == $("editId").value);

  return {
    id: $("editId").value ? Number($("editId").value) : Date.now(),
    companyId: existing ? existing.companyId : activeCompanyId,
    number: $("number").value.trim(),
    date: $("date").value,
    status: $("status").value,
    customer: $("customer").value,
    companyAddress: $("companyAddress").value,
    items: items,
    vat: Math.min(100, Math.max(0, Number($("vat").value) || 0)),
    notes: $("notes").value,
    payment: $("payment").value
  };
}

function saveQuote(e){
  e.preventDefault();
  const q = values();
  if (!q.number) return alert(t("quoteNumberRequired"));
  if (!q.customer) return alert(t("selectCompanyFirst"));
  if (!q.items.length) return alert(t("addAtLeastOneVehicle"));

  const isEdit = !!$("editId").value;
  if (!isEdit && !can("create")) return alert(t("noPermission"));
  if (isEdit && !can("edit"))    return alert(t("noPermission"));

  const idx = quotes.findIndex(x => x.id === q.id);
  if (idx >= 0) quotes[idx] = q; else quotes.unshift(q);

  persist();
  renderAll();
  toast(t("saved"));
  showPage("quotes", document.querySelector('[data-page="quotes"]'));
}

function editQuote(id){
  if (!can("edit")) return alert(t("noPermission"));
  const q = quotes.find(x => x.id === id); if (!q) return;

  if (q.companyId && q.companyId !== activeCompanyId) {
    activeCompanyId = q.companyId;
    localStorage.setItem(LS.activeCo, activeCompanyId);
    populateCompanyDropdown();
    populateQuoteFilters();
    applyTheme();
    renderAll();
  }
  populateSelects();

  $("number").value = q.number;
  $("date").value = q.date;
  $("status").value = q.status;
  $("customer").value = q.customer;
  $("companyAddress").value = q.companyAddress || "";
  $("vat").value = q.vat;
  $("notes").value = q.notes || "";
  $("payment").value = q.payment || "";
  $("editId").value = q.id;

  $("vehicleItemsContainer").innerHTML = "";
  if (q.items && q.items.length) {
    q.items.forEach(item => addVehicleRow(item));
  } else if (q.vehicle) {
    addVehicleRow({
      vehicle: q.vehicle,
      transportDetails: q.transportDetails,
      startDate: q.startDate,
      endDate: q.endDate,
      days: q.days,
      vehicles: q.vehicles,
      costVehicle: q.costVehicle
    });
  } else {
    addVehicleRow();
  }

  calc();
  showPage("new", document.querySelector('[data-page="quotes"]'));
}

function deleteQuote(id){
  if (!can("delete")) return alert(t("noPermission"));
  if (!confirm(t("confirmDelete"))) return;
  quotes = quotes.filter(q => q.id !== id);
  persist();
  renderAll();
  toast(t("deleted"));
}

