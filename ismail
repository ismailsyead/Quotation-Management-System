        <div class="grand" style="background:${themeColor} !important; border-color:${themeColor} !important; color:#fff !important;"><span>${t("grandTotal")}</span><b>${fmt(a.total)} SAR</b></div>
      </div>`;

    html += `<div data-block="table" style="position:absolute; top:${pY(l.table.y)}mm; left:${pX(l.table.x)}mm; width:${pW(l.table.w)}mm; height:${pY(l.table.h)}mm; overflow:hidden; z-index:2;">
      ${tableBody}
    </div>`;
  }

  if (!l.notes.hidden) {
    html += `<div data-block="notes" style="position:absolute; top:${pY(l.notes.y)}mm; left:${pX(l.notes.x)}mm; width:${pW(l.notes.w)}mm; height:${pY(l.notes.h)}mm; overflow:hidden;
      font-family:${l.notes.fontFamily}; font-size:${l.notes.fontSize}px; color:${l.notes.color};
      font-weight:${l.notes.bold !== false ? 700 : 400}; line-height:1.6; z-index:2;">
      <div class="qnotes" style="margin:0;">
        <b>${t("notes")}:</b><br>${esc(q.notes || "").replace(/\n/g, "<br>")}
        <p style="margin:6px 0;"><b>${t("paymentTerms")}:</b><br>${esc(q.payment || "").replace(/\n/g, "<br>")}</p>
      </div>
    </div>`;
  }

  if (!l.closing.hidden) {
    const closingMsg = comp.greetings.closing || t("closing");
    html += `<div data-block="closing" style="position:absolute; top:${pY(l.closing.y)}mm; left:${pX(l.closing.x)}mm; width:${pW(l.closing.w)}mm; height:${pY(l.closing.h)}mm; overflow:hidden;
      font-family:${l.closing.fontFamily}; font-size:${l.closing.fontSize}px; color:${l.closing.color};
      font-weight:${l.closing.bold !== false ? 700 : 400}; line-height:1.6; z-index:2;">
      ${esc(closingMsg)}
    </div>`;
  }

  html += `</div>`;
  return html;
}

function backButton(targetPage){
  return `<div class="no-print" style="padding:15px; text-align:right; background:var(--panel-bg); margin-bottom:10px; border-radius:10px;">
    <button class="btn-primary" onclick="showPage('${targetPage}',document.querySelector('[data-page=${targetPage}]'))">← ${t("backToList")}</button>
  </div>`;
}

function adjustPaperHeight(){
  const MM_TO_PX = 794 / 210;
  document.querySelectorAll('.quote-paper').forEach(paper => {
    const paperRect = paper.getBoundingClientRect();
    let maxBottomPx = 0;
    paper.querySelectorAll('[data-block]').forEach(block => {
      const rect = block.getBoundingClientRect();
      const bottomPx = rect.bottom - paperRect.top;
      if (bottomPx > maxBottomPx) maxBottomPx = bottomPx;
    });
    const neededMm = maxBottomPx / MM_TO_PX + 5;
    if (neededMm > 297) {
      paper.style.minHeight = neededMm + 'mm';
    }
  });
}

