function addMaster(type){
  const comp = getActiveCompany();

  if (editingMaster.type === type || (type === 'notes' && editingMaster.type === 'notesList')) {
    if (type === "customers") {
      const name = $("masterCustomerName").value.trim();
      if (!name) return alert(t("enterCompanyName"));
      comp.customers[editingMaster.index] = { name, address: $("masterCustomerAddress").value.trim() };
    } else if (type === "vehicles") {
      const name = $("masterVehicleName").value.trim();
      const cost = Number($("masterVehicleCost").value) || 0;
      if (!name) return alert(t("enterVehicleType"));
      comp.vehicles[editingMaster.index] = { name, cost };
    } else if (type === "payments") {
      const term = $("masterPayment").value.trim();
      if (!term) return alert(t("enterPaymentTerm"));
      comp.payments[editingMaster.index] = term;
    } else if (type === "notes") {
      const note = $("masterNoteInput").value.trim();
      if (!note) return alert(t("enterNote"));
      comp.notesList[editingMaster.index] = note;
    }
    cancelEditMaster();
  } else {
    if (type === "customers") {
      const name = $("masterCustomerName").value.trim();
      if (!name) return alert(t("enterCompanyName"));
      comp.customers.push({ name, address: $("masterCustomerAddress").value.trim() });
      $("masterCustomerName").value = ""; $("masterCustomerAddress").value = "";
    } else if (type === "vehicles") {
      const name = $("masterVehicleName").value.trim();
      const cost = Number($("masterVehicleCost").value) || 0;
      if (!name) return alert(t("enterVehicleType"));
      comp.vehicles.push({ name, cost });
      $("masterVehicleName").value = ""; $("masterVehicleCost").value = "";
    } else if (type === "payments") {
      let term = $("masterPayment").value.trim();
      if (!term) return alert(t("enterPaymentTerm"));
      if (!/^\d+\./.test(term)) term = `${comp.payments.length + 1}. ${term}`;
      comp.payments.push(term); $("masterPayment").value = "";
    } else if (type === "notes") {
      let note = $("masterNoteInput").value.trim();
      if (!note) return alert(t("enterNote"));
      if (!/^\d+\./.test(note)) note = `${comp.notesList.length + 1}. ${note}`;
      comp.notesList.push(note); $("masterNoteInput").value = "";
    }
  }

  persistCompanies(); renderMasters(); populateSelects(); populateQuoteFilters();
}

function removeMaster(type, i){
  if (!confirm(t("confirmDelete"))) return;
  const comp = getActiveCompany();
  comp[type].splice(i, 1);
  persistCompanies(); renderMasters(); populateSelects(); populateQuoteFilters();
}

