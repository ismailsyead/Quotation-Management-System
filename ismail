function autoAdjustLayout() {
  const container = $("pdfVisualEditor");
  if (!container) return;
  const layout = layoutOfEditTarget();
  const ch = container.clientHeight;

  const contentBlocks = ["customer", "intro", "table", "notes", "closing"];
  const savedH = {};
  contentBlocks.forEach(key => {
    const el = document.querySelector(`.drag-item[data-key="${key}"]`);
    if (el) { savedH[key] = el.style.height; el.style.height = "auto"; }
  });

  void container.offsetHeight;

  layout.offer.x = 75;
  layout.offer.y = 8;
  layout.offer.w = 20;
  const offerEl = document.querySelector('.drag-item[data-key="offer"]');
  layout.offer.h = offerEl ? Math.max(10, (offerEl.scrollHeight / ch) * 100 + 1) : 12;

  let currentY = Math.max(layout.offer.y + layout.offer.h + 2, 18);

  const cfg = {
    customer: { x: 10, w: 60 },
    intro:    { x: 10, w: 85 },
    table:    { x: 5,  w: 90 },
    notes:    { x: 10, w: 85 },
    closing:  { x: 10, w: 85 }
  };

  contentBlocks.forEach(key => {
    if (layout[key].hidden) return;
    const el = document.querySelector(`.drag-item[data-key="${key}"]`);
    if (!el) return;
    const h = (el.scrollHeight / ch) * 100 + 1.5;
    layout[key].x = cfg[key].x;
    layout[key].y = currentY;
    layout[key].w = cfg[key].w;
    layout[key].h = Math.round(h);
    currentY += h + 2;
  });

  contentBlocks.forEach(key => {
    const el = document.querySelector(`.drag-item[data-key="${key}"]`);
    if (el && savedH[key] !== undefined) el.style.height = savedH[key];
  });

  syncVisualEditorFromLayout(layout);
  updateLayoutFromVisual();
  toast(t("blocksArranged"));
}

